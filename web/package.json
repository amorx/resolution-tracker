    "@vitest/coverage-v8": "2.1.4",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "jsdom": "25.0.1",
    "license-checker": "25.0.1",
    "msw": "2.6.4",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.14",
