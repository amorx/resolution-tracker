    "licenses": "license-checker --production --onlyAllow 'MIT;MIT-0;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC-BY-4.0;CC0-1.0;Unlicense;Python-2.0;BlueOak-1.0.0' --summary"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.16",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.4.1",
    "react-router-dom": "6.27.0",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "2.0.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
