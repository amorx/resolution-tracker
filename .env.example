# Copy to `.env` and adjust for local development.
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# URL of the Ollama daemon.
# Docker Compose (macOS / Docker Desktop): keep the default below.
# Local dev outside Docker: change to http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434

# Ollama model to use. gemma4:26b must already be pulled on the host.
# Override to a smaller model (e.g. llama3.1:8b) if needed.
OLLAMA_MODEL=gemma4:26b

# Comma-separated hours (24h) when the local coach sends a check-in.
CHECKIN_HOURS=9,13,18
